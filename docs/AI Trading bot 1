from newsapi import NewsApiClient
from transformers import pipeline
import json, time, os
from datetime import datetime

newsapi = NewsApiClient(api_key="YOUR_FREE_NEWSAPI_KEY")  # get at newsapi.org
sentiment_pipeline = pipeline("sentiment-analysis", model="ProsusAI/finbert")

coins = ["BTC", "ETH", "SOL", "BNB", "XRP"]
SENTIMENT_FILE = "user_data/sentiment_scores.json"

def update_sentiment():
    scores = {coin: 0.0 for coin in coins}
    articles = newsapi.get_everything(q="crypto OR bitcoin OR ethereum OR solana",
                                      language="en", sort_by="publishedAt", page_size=50)

    for a in articles["articles"]:
        title = a["title"].lower()
        res = sentiment_pipeline(a["title"])[0]
        score = res["score"] if res["label"] == "positive" else -res["score"]

        for coin in coins:
            if coin.lower() in title:
                scores[coin] += score

    # Normalise to -1 … +1
    for c in scores:
        scores[c] = max(min(scores[c] / 10, 1.0), -1.0)   # simple scaling

    data = {"timestamp": datetime.utcnow().isoformat(), "scores": scores}
    with open(SENTIMENT_FILE, "w") as f:
        json.dump(data, f)

    print(f"[{datetime.now()}] Sentiment updated → {scores}")

if __name__ == "__main__":
    os.makedirs("user_data", exist_ok=True)
    while True:
        update_sentiment()
        time.sleep(600)  # every 10 min

